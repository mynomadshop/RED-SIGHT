# RedSight - High-Performance Local AI Intelligence Platform
# Environment Configuration
# Copy this file to .env and fill in your values

# Platform
RED_SIGHT_PLATFORM__MODE=local_preferred
RED_SIGHT_PLATFORM__DATA_ROOT=./data

# LM Studio
RED_SIGHT_LMSTUDIO__BASE_URL=http://127.0.0.1:1234/v1
RED_SIGHT_LMSTUDIO__TIMEOUT_SECONDS=180
# RED_SIGHT_LMSTUDIO__MODEL_ID=your-local-model-id
# RED_SIGHT_LMSTUDIO__EMBEDDING_MODEL_ID=your-local-embedding-model-id

# Qdrant. Set EMBEDDED=true for a persistent in-process local store.
RED_SIGHT_RETRIEVAL__VECTOR_BACKEND_URL=http://127.0.0.1:6333
RED_SIGHT_RETRIEVAL__VECTOR_BACKEND_HOST=127.0.0.1
RED_SIGHT_RETRIEVAL__VECTOR_BACKEND_PORT=6333
RED_SIGHT_RETRIEVAL__VECTOR_BACKEND_EMBEDDED=false
# RED_SIGHT_RETRIEVAL__VECTOR_BACKEND_PATH=./data/qdrant_db

# Retrieval and GPU
RED_SIGHT_RETRIEVAL__ENABLE_EMBEDDINGS=false
RED_SIGHT_RETRIEVAL__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RED_SIGHT_ROUTING__VRAM_HEADROOM_GB_PER_GPU=3.0

# Logging
RED_SIGHT_TELEMETRY__LOG_LEVEL=INFO

# Local API security (generated automatically by the Windows installer).
# Set one strong random value when running the desktop/gateway and Docker in
# separate processes so they authenticate to the same RedSight API.
# REDSIGHT_LOCAL_API_TOKEN=

# Provider selection. The Windows app writes these values from Settings and
# stores API keys with CurrentUser DPAPI; environment variables remain useful
# for source installs and headless deployments.
# Values: none | lmstudio | openai | anthropic | gemini | xai | openrouter |
#         groq | mistral | together | deepseek | cerebras | custom
# REDSIGHT_ACTIVE_PROVIDER=lmstudio
# REDSIGHT_PROVIDER_MODEL=

# Cloud access is disabled unless the routing policy explicitly allows it.
RED_SIGHT_ROUTING__CLOUD_FALLBACK=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# CEREBRAS_API_KEY=
# REDSIGHT_CUSTOM_API_KEY=

# Every provider endpoint can be overridden from Settings or the environment.
# REDSIGHT_OPENAI_BASE_URL=https://api.openai.com/v1
# REDSIGHT_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# REDSIGHT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# REDSIGHT_XAI_BASE_URL=https://api.x.ai/v1
# REDSIGHT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# REDSIGHT_GROQ_BASE_URL=https://api.groq.com/openai/v1
# REDSIGHT_MISTRAL_BASE_URL=https://api.mistral.ai/v1
# REDSIGHT_TOGETHER_BASE_URL=https://api.together.xyz/v1
# REDSIGHT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# REDSIGHT_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# REDSIGHT_CUSTOM_BASE_URL=

# Earlier flat variable names remain accepted for upgraded installations.
