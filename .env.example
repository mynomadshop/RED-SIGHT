# RedSight - High-Performance Local AI Intelligence Platform
# Environment Configuration
# Copy this file to .env and fill in your values

# Platform
RED_SIGHT_MODE=local_preferred
RED_SIGHT_DATA_ROOT=./data

# LM Studio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_TIMEOUT=180

# Qdrant (optional - for production)
QDRANT_URL=http://127.0.0.1:6333

# GPU
GPU_VRAM_HEADROOM_GB=3.0

# Logging
LOG_LEVEL=INFO

# Security (optional)
# RED_SIGHT_API_KEY=your-secret-key-here

# Embedding Model
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Qdrant Collection
# QDRANT_COLLECTION=redsight_knowledge
